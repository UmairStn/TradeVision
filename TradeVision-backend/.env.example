# Copy this to `.env` in the same directory (TradeVision-backend/.env).
#
# `.env` is gitignored at any depth; this example is not — so never put a real
# key in this file.
#
# docker/docker-compose.yml pulls this file in via `env_file: ../.env`, so a
# plain `docker compose -f docker/docker-compose.yml up backend-dev` picks it up
# with no extra flags. It is also the file python-dotenv would look for if you
# ever run uvicorn on the host instead of in Docker.
#
# Everything here is optional. With no .env at all the backend still boots and
# serves market data and predictions; only /api/v1/chat reports 503.

# Google AI Studio key for the chat assistant: https://aistudio.google.com/apikey
# Never returned to the client and never logged — the browser talks to
# /api/v1/chat, and only the backend holds the key.
GEMINI_API_KEY=

# Chat model. gemini-2.5-flash is the default — cheap and fast enough for a tool
# loop that makes two or more round trips per message.
# GEMINI_MODEL=gemini-2.5-flash
# The secret used to sign Supabase JWTs, found in Project Settings -> API
SUPABASE_JWT_SECRET=your-jwt-secret
# Connection string for Supabase PostgreSQL database
SUPABASE_DB_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Seconds to cache CSE market lists. Short on purpose: the whole point of the CSE
# feed is that it is fresher than the model's Yahoo history.
# CSE_CACHE_TTL=60

# Seconds to cache a symbol's news sentiment. A cold scrape plus FinBERT costs
# 30-90s, and news moves on a scale of hours.
# SENTIMENT_CACHE_TTL=3600
