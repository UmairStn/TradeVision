# ==========================================
# TradeVision Master .gitignore
# ==========================================

# --- System Files ---
.DS_Store
Thumbs.db

# --- IDEs and Editors ---
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp

# --- Python (Backend) ---
**/__pycache__/
**/*.pyc
**/*.pyo
**/*.pyd
**/.pytest_cache/
**/.coverage
**/htmlcov/
**/.venv/
**/venv/
**/env/
**/ENV/
**/dist-backend/
**/.eggs/
**/*.egg-info/

# --- Node / React (Frontend) ---
**/node_modules/
**/dist/
**/build/
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.eslintcache

# --- Docker ---
**/.docker/
**/*.log

# --- ML training data & outputs ---
# Regenerated by `python -m ml.fetch_data` — ~50 CSVs of Yahoo price history.
# Data, not source: keep it out of git history.
TradeVision-backend/ml/data/
TradeVision-backend/ml/*.png
TradeVision-backend/ml/model_comparison.csv

# NOTE: models/*.json is deliberately NOT ignored. The trained artifact must be
# committed — prod has no bind mount and loads it from inside the image.
