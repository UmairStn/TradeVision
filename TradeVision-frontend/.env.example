# Copy this to `.env` in the same directory (TradeVision-frontend/.env).
#
# `.env` is gitignored at any depth; this example is not.
#
# This is Vite's own native location, which is why it lives here rather than in
# docker/. One file covers both ways of running the app:
#
#   npm run dev on the host  -> Vite reads ./.env directly
#   frontend-dev container   -> the `..:/app` bind mount makes this the same
#                               file at /app/.env, so Vite reads it there too
#
# The production container is the exception. `npm run build` inlines
# import.meta.env into the bundle, so the value has to be present at BUILD time
# and arrives as a Docker build arg instead — see the ARG note in
# docker/Dockerfile. This file is excluded from the build context on purpose
# (see .dockerignore), so it can never be baked into an image layer.
#
# To build the prod bundle against this same file, from TradeVision-frontend/:
#
#   docker compose -f docker/docker-compose.yml --env-file .env \
#     --profile prod up --build
#
# (--env-file is relative to your shell's directory, not to the compose file.)
# Or for a one-off target:
#
#   VITE_API_URL=https://api.example.com docker compose \
#     -f docker/docker-compose.yml --profile prod up --build
#
# Optional: api.ts falls back to http://localhost:8000, which is already correct
# whenever the backend is published on the same machine as the browser.

# Where the browser should reach the TradeVision backend.
VITE_API_URL=http://localhost:8000
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
