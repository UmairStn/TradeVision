# Dependencies installed by npm/node
node_modules

# Vite production build output (not needed in image source context)
dist
dist-ssr

# OS & editor noise
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.idea
.vscode

# Git history (not needed in the image)
.git
.gitignore

# Logs
*.log
npm-debug.log*

# Local environment overrides.
#
# .env is excluded too, deliberately: the prod bundle receives VITE_API_URL as a
# build ARG, so a host .env must never be copied in and frozen into an image
# layer. This does not affect frontend-dev — bind mounts ignore .dockerignore, so
# the dev container still reads /app/.env through the `..:/app` mount.
*.local
.env
.env.*
